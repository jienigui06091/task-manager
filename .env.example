# PostgreSQL running on the Docker host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskDB
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-long-random-secret
APP_PORT=8080
BACKEND_IMAGE=ghcr.io/jienigui06091/task-manager-api:latest
FRONTEND_IMAGE=ghcr.io/jienigui06091/task-manager-frontend:latest
